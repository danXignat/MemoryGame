{
  "name": "drpciv-road-signs-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mobile-first 2D driving game for learning Romanian road signs (DRPCIV).",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "artifact": "node scripts/build-artifact.mjs",
    "test": "node tests/sim.test.mjs",
    "app": "node scripts/build-app.mjs && npx cap sync",
    "apk": "node scripts/build-app.mjs && npx cap sync android && cd android && ./gradlew assembleDebug"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^7.6.10",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/core": "^7.6.10",
    "@capacitor/ios": "^7.6.10"
  }
}
